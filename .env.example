# ── Content dashboard (Sanity, free) ─────────────────────────
# From sanity.io/manage → your project. Without it the site uses src/content/data.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only for the one-time import (npm run seed). Never commit a real token.
SANITY_API_WRITE_TOKEN=

# ── Contact form (Web3Forms, free) ───────────────────────────
# Enter your email at https://web3forms.com to get a key. Without it the form opens an email draft.
NEXT_PUBLIC_WEB3FORMS_KEY=
